              }
            ],
            "title": "Address"
          },
          "document_number": {
            "title": "Document Number",
            "type": "string"
          },
          "document_type": {
            "$ref": "#/components/schemas/DocumentType"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "phone": {
            "title": "Phone",
