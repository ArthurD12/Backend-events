          "name",
          "document_type",
          "document_number",
          "phone",
          "email",
          "address",
          "active"
        ],
        "title": "ClientOut",
        "type": "object"
      },
      "DocumentType": {
        "enum": [
          "DNI",
          "RUC"
        ],
        "title": "DocumentType",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PriceUnit": {
        "description": "Cómo se cobra el servicio: el buffet por persona, lo demás por unidad.",
        "enum": [
          "PER_PERSON",
          "PER_UNIT"
        ],
        "title": "PriceUnit",
        "type": "string"
      },
      "Problem": {
        "description": "Error de negocio. `code` no cambia aunque cambie el texto de `detail`.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status",
          "code",
          "detail"
        ],
        "title": "Problem",
        "type": "object"
      },
      "ServiceIn": {
        "properties": {
          "category_id": {
            "format": "uuid",
            "title": "Category Id",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "price_unit": {
            "$ref": "#/components/schemas/PriceUnit",
            "description": "PER_PERSON (buffet) o PER_UNIT (lo demás)"
          },
          "reference_price_cents": {
            "description": "Precio referencial en céntimos: S/ 45.00 = 4500",
            "title": "Reference Price Cents",
            "type": "integer"
          }
        },
        "required": [
          "name",
          "category_id",
          "price_unit",
          "reference_price_cents"
        ],
        "title": "ServiceIn",
        "type": "object"
      },
      "ServiceOut": {
        "properties": {
          "active": {
            "title": "Active",
            "type": "boolean"
          },
          "category_id": {
            "format": "uuid",
            "title": "Category Id",
            "type": "string"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "price_unit": {
            "$ref": "#/components/schemas/PriceUnit"
          },
          "reference_price_cents": {
            "title": "Reference Price Cents",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "category_id",
          "price_unit",
          "reference_price_cents",
          "currency",
          "description",
          "active"
        ],
        "title": "ServiceOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
