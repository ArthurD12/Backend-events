# Copia este archivo como .env y cambia la clave. El archivo .env NO se sube a GitHub.

# Base de datos local (docker compose)
POSTGRES_USER=darze
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=darze
POSTGRES_PORT=5433

# 127.0.0.1 y ssl=disable evitan cortes de conexión en Windows con Docker Desktop.
DATABASE_URL=postgresql+asyncpg://darze:cambia-esta-clave@127.0.0.1:5433/darze?ssl=disable

# Páginas web que pueden llamar a la API. Si no se define, solo el frontend en desarrollo.
# CORS_ORIGINS=["http://localhost:3000"]

# Clave para firmar las sesiones (JWT). Obligatoria, mínimo 32 caracteres, distinta en cada
# instalación. Genera una con: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
