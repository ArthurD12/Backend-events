# Copia este archivo como .env y cambia la clave. El archivo .env NO se sube a GitHub.

# Base de datos local (docker compose)
POSTGRES_USER=darze
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=darze
POSTGRES_PORT=5432

# Conexión de la API (usa los mismos valores de arriba)
DATABASE_URL=postgresql+asyncpg://darze:cambia-esta-clave@localhost:5432/darze
